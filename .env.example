# URL base de FicaTostadoresWEB (API: heartbeat, etc.)
VITE_WEB_API_URL=http://localhost:3000

# Firebase (cliente — mismas claves públicas que usa la web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Secreto compartido con la web para POST /api/electron/heartbeat
# Debe ser idéntico a COTIZACIONES_APP_SECRET en el .env de FicaTostadoresWEB
VITE_COTIZACIONES_APP_SECRET=
